<resources>
    <style name="Theme.Qibla" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="buttonStyle">@style/Widget.Qibla.Button</item>
        <item name="colorButtonNormal">@color/accent_tint</item>
        <item name="android:colorButtonNormal">@color/accent_tint</item>
    </style>

    <style name="Widget.Qibla.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_soft</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Theme.Qibla.Toolbar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="Theme.Qibla.NoAnim" parent="Theme.Qibla">
        <item name="android:windowAnimationStyle">@style/Anim.Qibla.None</item>
    </style>

    <style name="Anim.Qibla.None" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/none</item>
        <item name="android:activityOpenExitAnimation">@anim/none</item>
        <item name="android:activityCloseEnterAnimation">@anim/none</item>
        <item name="android:activityCloseExitAnimation">@anim/none</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/panel_stroke" />
        </shape>
    </item>

    <item>
        <ripple android:color="@color/accent_soft">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_tint" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/accent_soft" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>

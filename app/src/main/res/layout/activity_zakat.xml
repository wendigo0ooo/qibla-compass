<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/zakatToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:theme="@style/Theme.Qibla.Toolbar"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/zk_assets"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/zNakit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_nakit"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/zAltinG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_altin_g"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/zGumusG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_gumus_g"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/zDiger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_diger"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/zBorc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_borc"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="@string/zk_prices"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/zAltinFiyat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_altin_fiyat"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/zGumusFiyat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zk_gumus_fiyat"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/zCalc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/zk_calc" />

            <TextView
                android:id="@+id/zResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_bg"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="@string/zk_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
